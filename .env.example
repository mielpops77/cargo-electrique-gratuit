# Port du serveur
PORT=3000

# Protection par mot de passe partagé (recommandé dès que l'app est
# hébergée/accessible publiquement). Laisse APP_PASSWORD vide pour
# désactiver la protection (pratique en local).
APP_USERNAME=miaoupost
APP_PASSWORD=

# URL publique de ce serveur (nécessaire car Instagram et TikTok
# récupèrent le média en le téléchargeant depuis une URL publique).
# Ex: un tunnel (cloudflared/ngrok) ou ton domaine si le serveur est exposé.
PUBLIC_BASE_URL=https://ton-domaine-ou-tunnel.example.com

# --- Facebook / Instagram (Meta Graph API) ---
# Page Facebook liée à ton compte Instagram Business/Creator.
# Génère un token longue durée depuis https://developers.facebook.com/tools/explorer
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- YouTube (Google) ---
# Crée un OAuth client (type "Desktop") sur https://console.cloud.google.com
# puis récupère un refresh token via OAuth Playground avec le scope
# https://www.googleapis.com/auth/youtube.upload
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- TikTok (Content Posting API) ---
# Token obtenu via le flux OAuth TikTok for Developers.
# Tant que l'app n'est pas auditée, la publication reste en visibilité
# restreinte (privée/brouillon).
TIKTOK_ACCESS_TOKEN=
